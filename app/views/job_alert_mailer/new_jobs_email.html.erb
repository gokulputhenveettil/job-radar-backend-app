<!-- backend/app/views/job_alert_mailer/new_jobs_email.html.erb -->
<h2>New Job Openings Found</h2>
<table style="width: 100%; border-collapse: collapse; font-family: sans-serif;">
  <thead>
    <tr style="text-align: left; border-bottom: 2px solid #ddd;">
      <th style="padding: 8px;">Role</th>
      <th style="padding: 8px;">Company</th>
      <th style="padding: 8px;">Location</th>
      <th style="padding: 8px;">Action</th>
    </tr>
  </thead>
  <tbody>
    <% @jobs.each do |job| %>
      <tr style="border-bottom: 1px solid #eee;">
        <td style="padding: 8px; font-weight: bold;"><%= job.title %></td>
        <td style="padding: 8px;"><%= job.company %></td>
        <td style="padding: 8px;"><%= job.location %></td>
        <td style="padding: 8px;">
          <a href="<%= job.url %>" style="color: #0a66c2; font-weight: bold;">View on LinkedIn &rarr;</a>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>